# NetHunter Core for Snapdragon (taro)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_QUALCOMM=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_WEXT=y
# Monitor Mode & Packet Injection
CONFIG_QCACLD_WLAN_MONITOR=y
CONFIG_QCACLD_MONITOR_MODE_AF_RAW=y
# Bluetooth HCI
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_VHCI=y
# HID Gadget (Keyboard/Mouse Attacks)
CONFIG_USB_F_HID=y
CONFIG_USB_CONFIGFS_F_HID=y
